# ==================================================
# Environment Configuration
# AI-Based Internship Recommendation Engine
# For PM Internship Scheme
# ==================================================

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Configuration:
# 1. MongoDB Atlas (Cloud / Serverless):
# DATABASE_URL="mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/pminternship?retryWrites=true&w=majority"
# 2. PostgreSQL (Standard relational / Docker):
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/internship_db?schema=public
# 3. SQLite (Zero-config local fallback):
# DATABASE_URL="file:./dev.db"

# Security & JWT Tokens
JWT_SECRET=your_super_secret_jwt_key_min_32_characters_here
JWT_REFRESH_SECRET=your_super_secret_refresh_token_key_here
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

# Recommendation & AI Engine
# Options: LOCAL_ML (default zero-dep TF-IDF + Cosine), GEMINI, HYBRID
AI_PROVIDER=LOCAL_ML
GEMINI_API_KEY=

# File Uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=5

# Optional Redis Cache
REDIS_URL=redis://localhost:6379
