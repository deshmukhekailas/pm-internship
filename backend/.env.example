# ==================================================
# Backend Environment Configuration
# ==================================================
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database options:
# 1. MongoDB Atlas (Recommended for cloud/serverless):
# DATABASE_URL="mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/pminternship?retryWrites=true&w=majority"
# 2. PostgreSQL (Standard relational / Docker):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/internship_db?schema=public
# 3. SQLite (Zero-config local development):
DATABASE_URL="file:./dev.db"

# JWT Security
JWT_SECRET=your_super_secret_jwt_key_min_32_characters_here
JWT_REFRESH_SECRET=your_super_secret_refresh_token_key_here
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

# AI Recommendation Engine (LOCAL_ML, GEMINI, HYBRID)
AI_PROVIDER=LOCAL_ML
GEMINI_API_KEY=

# File Uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=5

# Optional Redis Cache
REDIS_URL=redis://localhost:6379
