# ==================================================
# Backend Environment Configuration Template
# ==================================================
PORT=5000
NODE_ENV=development
CLIENT_URL=https://pm-internship-gjjg.vercel.app

# Database Configuration (MongoDB Atlas Recommended for Cloud):
DATABASE_URL="mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/pminternship?retryWrites=true&w=majority"

# JWT Security
JWT_SECRET=your_super_secret_jwt_key_min_32_characters_here
JWT_REFRESH_SECRET=your_super_secret_refresh_token_key_here
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

# AI Recommendation Engine (LOCAL_ML, GEMINI, HYBRID)
AI_PROVIDER=LOCAL_ML
GEMINI_API_KEY=your_gemini_api_key_here

# File Uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=5

# Optional Redis Cache
REDIS_URL=redis://localhost:6379

# SMTP Email Configuration (For production OTP emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM="PM Internship Scheme" <noreply@pminternship.gov.in>

# Google OAuth2 Client ID (from Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
