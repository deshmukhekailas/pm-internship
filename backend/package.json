{
  "name": "internship-backend",
  "version": "1.0.0",
  "description": "Backend API for AI-Based Internship Recommendation Engine for PM Internship Scheme",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:mongo:generate": "prisma generate --schema=prisma/schema.mongo.prisma",
    "prisma:mongo:push": "prisma db push --schema=prisma/schema.mongo.prisma",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "tsx src/database/seed.ts",
    "prisma:seed:clean": "tsx src/database/seed.clean.ts",
    "seed:clean": "tsx src/database/seed.clean.ts",
    "db:purge:students": "tsx src/database/clearData.ts",
    "db:check": "tsx src/database/checkData.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "pdf-parse": "^1.1.1",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.8.7",
    "@types/pdf-parse": "^1.1.4",
    "@types/swagger-ui-express": "^4.1.6",
    "prisma": "^5.22.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
